# AI provider: openai (prototype default) or bedrock
AI_PROVIDER=openai

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Anthropic Claude (inference profile recommended for Sonnet 3.5 v2+):
#   us.anthropic.claude-3-5-sonnet-20241022-v2:0
# Amazon Nova 2 Lite (inference profile — required for Nova 2 in most accounts):
#   us.amazon.nova-2-lite-v1:0
# Do not use amazon.nova-2-lite-v1:0 unless on-demand is enabled for your account.
# Older ids like anthropic.claude-3-5-sonnet-20240620-v1:0 are end-of-life.
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# OpenAI (when AI_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-5-mini

PORT=8787
